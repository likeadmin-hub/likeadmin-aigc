.decoration-tabbar { position:fixed;left:0;right:0;bottom:0;display:flex;z-index:999;height:100rpx;padding-bottom:env(safe-area-inset-bottom);box-sizing:content-box;border-top:1rpx solid rgba(0,0,0,.05); }
.decoration-tabbar__item { flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx; }
.decoration-tabbar__icon { width:44rpx;height:44rpx; }
.decoration-tabbar__label { max-width:100%;font-size:24rpx;line-height:1.2;overflow:hidden;white-space:nowrap;text-overflow:ellipsis; }
