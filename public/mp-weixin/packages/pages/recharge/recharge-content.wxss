.recharge.data-v-DKpMTA{box-sizing:border-box;padding:16px 16px calc(24px + env(safe-area-inset-bottom));background:var(--tool-page);color:var(--tool-text);font-size:14px;line-height:22px}.recharge-amount.data-v-DKpMTA{width:100%;height:56px;box-sizing:border-box;padding:8px 0;color:var(--tool-text);font-size:28px;line-height:40px}.recharge-heading.data-v-DKpMTA{margin:14rpx 0 20rpx;color:var(--tool-text, #222);font-size:34rpx;font-weight:700}.recharge-heading--secondary.data-v-DKpMTA{margin-top:40rpx}.recharge-state.data-v-DKpMTA{padding:44rpx 20rpx;border-radius:14rpx;background:var(--tool-surface, #fff);color:var(--tool-text-secondary, #888);text-align:center;font-size:24rpx}.package-grid.data-v-DKpMTA{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}.package-card.data-v-DKpMTA{position:relative;min-height:138rpx;padding:24rpx;border:1px solid var(--tool-border);border-radius:16rpx;background:var(--tool-surface, #fff)}.package-card.selected.data-v-DKpMTA{border-color:var(--tool-primary-border);background:var(--tool-primary-soft)}.package-recommend.data-v-DKpMTA{position:absolute;top:0;right:0;padding:3rpx 10rpx;border-radius:0 14rpx 0 10rpx;background:var(--color-primary);color:#fff;font-size:20rpx}.package-name.data-v-DKpMTA{color:var(--tool-text, #222);font-size:27rpx;font-weight:600}.package-points.data-v-DKpMTA{margin-top:12rpx;color:var(--tool-text-secondary, #555);font-size:25rpx}.package-price.data-v-DKpMTA{margin-top:12rpx;color:var(--tool-text, #222);font-size:31rpx;font-weight:700}.package-market.data-v-DKpMTA{color:var(--tool-text-muted, #aaa);font-size:21rpx;text-decoration:line-through}.recharge-summary.data-v-DKpMTA{display:flex;justify-content:space-between;margin-bottom:18rpx;color:var(--tool-text-secondary, #555);font-size:24rpx}.recharge-summary .account-strong.data-v-DKpMTA{color:var(--tool-text, #222);font-size:30rpx}.account-strong.data-v-DKpMTA{font-weight:600}.account-deleted.data-v-DKpMTA{text-decoration:line-through}
