.cw-mobile{color:var(--tool-text, #272b34);font-size:14px;line-height:1.6}.cw-m-button,.cw-m-option,.cw-m-card{font-size:14px;margin:0;line-height:1.5}.cw-m-button:after,.cw-m-option:after,.cw-m-card:after{border:0}.cw-m-label{display:block;font-weight:600;margin-bottom:8px}.cw-m-control{box-sizing:border-box;width:100%;border:1px solid var(--tool-border, #e1e4eb);border-radius:10px;padding:12px;background:var(--tool-card, #fff);color:var(--tool-text, #272b34);font-size:14px}.cw-m-textarea{min-height:150px}.cw-m-field{margin-bottom:16px}.cw-m-options{display:flex;flex-wrap:wrap;gap:8px}.cw-m-option{padding:8px 12px;border:1px solid var(--tool-border, #e1e4eb);background:transparent;border-radius:8px;color:inherit}.cw-m-selected{border-color:var(--tool-primary, #5965e9);color:var(--tool-primary, #5965e9)}.cw-m-help{font-size:12px;color:var(--tool-muted, #808796);margin-top:6px}.cw-m-button{background:var(--tool-primary, #5965e9);color:var(--tool-primary-text, #fff);padding:12px 18px;border-radius:10px}.cw-m-result{padding:16px;border:1px solid var(--tool-border, #e1e4eb);background:var(--tool-card, #fff);border-radius:14px}.cw-m-body{white-space:pre-wrap;overflow-wrap:anywhere}.cw-m-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.cw-m-heading{font-size:20px;font-weight:650;margin:28px 0 14px}.cw-m-card{width:100%;padding:16px;border-radius:12px;background:var(--tool-card, #fff);border:1px solid var(--tool-border, #e1e4eb);text-align:left;color:inherit;min-height:94px}.cw-m-title{font-size:15px;font-weight:600}.cw-m-error{color:#cf4550;font-size:13px;margin-top:8px}.cw-m-empty{padding:36px 10px;color:var(--tool-muted, #808796);text-align:center}.cw-m-tool-icon{width:28px;height:28px;flex-shrink:0}.cw-m-icon-fallback{display:flex;align-items:center;justify-content:center;color:#6b63ff;background:#eeebff;border-radius:8px}.cw-m-card .cw-m-title{min-width:0;overflow:hidden;text-overflow:ellipsis}.cw-m-card .cw-m-help{flex-shrink:0}.cw-m-tool-group:first-child .cw-m-heading{margin-top:23px}.cw-m-tool-group:first-child .cw-m-heading{margin-top:12px}
