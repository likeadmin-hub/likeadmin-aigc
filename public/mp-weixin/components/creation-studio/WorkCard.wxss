.work-card.data-v-ldeijg{min-width:0;overflow:hidden;border:1px solid var(--tool-border);border-radius:14px;background:var(--tool-surface);color:var(--tool-text)}.work-cover.data-v-ldeijg{position:relative;height:310rpx;background:var(--tool-surface-muted)}.work-image.data-v-ldeijg{display:block;width:100%;height:100%}.work-placeholder.data-v-ldeijg{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--tool-text-secondary);font-size:13px}.work-state.data-v-ldeijg{position:absolute;bottom:8px;left:8px;max-width:calc(100% - 16px);padding:4px 8px;border-radius:8px;background:var(--tool-surface);color:var(--tool-text-secondary);font-size:12px}.work-body.data-v-ldeijg{padding:12px}.work-prompt.data-v-ldeijg{min-height:3em;font-size:14px;line-height:1.5;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.work-actions.data-v-ldeijg{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;margin-top:8px}.work-action.data-v-ldeijg{display:flex;align-items:center;justify-content:center;gap:4px;min-width:0;min-height:44px;padding:0;margin:0;border:1px solid var(--tool-border);border-radius:10px;background:var(--tool-surface-muted);color:var(--tool-text);font-size:13px;line-height:1.4}.work-action.data-v-ldeijg:after{border:0}
