.payment-sheet{height:78vh;max-height:1100rpx}.payment-header{flex-shrink:0;padding:40rpx 90rpx 32rpx}.payment-scroll{height:0;min-height:0}.payment-summary{padding:0 36rpx}.payment-product-name{font-size:38rpx;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.payment-detail-row,.payment-method-row{display:flex;justify-content:space-between;gap:24rpx;padding:14rpx 0;font-size:28rpx;line-height:1.6}.payment-detail-value{text-align:right;overflow-wrap:anywhere}.payment-rights-group{margin:20rpx 0}.payment-apps{display:flex;flex-wrap:wrap;gap:12rpx}.payment-app{padding:8rpx 16rpx;border-radius:8rpx;font-size:24rpx}.payment-feature{font-size:26rpx;line-height:1.8;overflow-wrap:anywhere}.payment-total{align-items:center;margin-top:16rpx}.payment-total-amount{font-size:40rpx;font-weight:600}.payment-method-row{margin:12rpx 36rpx 24rpx}.payment-help-toggle{position:absolute;right:90rpx;top:24rpx;padding:10rpx}.payway-lists .payway-item{border-bottom:1px solid;border-color:var(--color-bg, #f6f6f6)}
