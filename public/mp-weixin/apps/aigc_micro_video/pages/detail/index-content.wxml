<micro-page wx:if="{{M}}" u-s="{{['actions','d']}}" u-i="b14a8678-0" bind:__l="__l" u-p="{{M}}"><view wx:if="{{a}}" class="error" role="alert">{{b}}<button class="link" disabled="{{c}}" bindtap="{{d}}"> 刷新作品状态 </button></view><view wx:if="{{e}}" class="card">正在读取作品…</view><block wx:if="{{f}}"><view class="card"><text class="title">{{g}}</text><text class="muted">{{h}}</text><text class="hint">{{i}}</text></view><view wx:if="{{j}}" class="card"><video src="{{k}}" poster="{{l}}" class="work-video" controls autoplay="{{false}}"/><text class="hint">实际成片时长 {{m}} 秒。保留生成视频的原音轨。</text><button class="primary" disabled="{{o}}" bindtap="{{p}}">{{n}}</button></view><view wx:else class="card"><text class="heading">{{q}}</text><text class="muted">{{r}}</text><button wx:if="{{s}}" class="primary" bindtap="{{t}}"> 查看创作方案 </button></view><view wx:if="{{v}}" class="card"><text class="heading">继续完成这部作品</text><text class="muted">只继续尚未完成的内容，已经成功的内容会保留。先核对新增费用，再确认继续。</text><button disabled="{{x}}" bindtap="{{y}}">{{w}}</button><view wx:if="{{z}}" class="quote-box"><text class="heading">本次新增费用：{{A}} 点</text><text class="muted">确认后按当前报价继续。若只需重新合成，以此处实际报价为准。</text><button class="primary" disabled="{{B}}" loading="{{C}}" bindtap="{{D}}"> 确认继续生成 </button></view></view><view class="card"><view class="heading"><text>本次创作</text></view><text class="muted">{{E}}</text><text class="hint">{{F}} · {{G}} · 目标 {{H}} 秒</text><text class="hint">所选时长为创作目标，最终时长以实际返回并合成的视频为准。</text></view></block><view slot="actions"><button bindtap="{{I}}">创作记录</button><button disabled="{{J}}" bindtap="{{K}}">刷新状态</button><button class="primary" bindtap="{{L}}">再创作一部</button></view></micro-page>