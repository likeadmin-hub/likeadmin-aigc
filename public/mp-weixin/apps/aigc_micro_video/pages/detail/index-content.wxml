<micro-page wx:if="{{P}}" u-s="{{['actions','d']}}" u-i="1c62c0c2-0" bind:__l="__l" u-p="{{P}}"><view wx:if="{{a}}" class="error" role="alert">{{b}}<button class="link" disabled="{{c}}" bindtap="{{d}}"> 刷新作品状态 </button></view><view wx:if="{{e}}" class="card">正在读取作品…</view><block wx:if="{{f}}"><view class="detail-hero"><view wx:if="{{g}}" class="detail-player"><video src="{{h}}" poster="{{i}}" class="work-video" controls autoplay="{{false}}"/></view><view wx:else class="detail-placeholder"><text class="detail-placeholder-label">{{j}}</text><text class="muted">{{k}}</text><button wx:if="{{l}}" class="primary" bindtap="{{m}}"> 查看创作方案 </button></view><view class="detail-summary"><view class="detail-summary-top"><text class="detail-title">{{n}}</text><text class="{{['work-status',p&&'work-status-failed']}}">{{o}}</text></view><text class="detail-date">{{q}}</text><view wx:if="{{r}}" class="detail-save-row"><text class="detail-duration">成片 {{s}} 秒</text><button class="detail-save" disabled="{{v}}" bindtap="{{w}}">{{t}}</button></view></view></view><view wx:if="{{x}}" class="card"><text class="heading">继续完成这部作品</text><text class="muted">只继续尚未完成的内容，已经成功的内容会保留。先核对新增费用，再确认继续。</text><button disabled="{{z}}" bindtap="{{A}}">{{y}}</button><view wx:if="{{B}}" class="quote-box"><text class="heading">本次新增费用：{{C}} 点</text><text class="muted">确认后按当前报价继续。若只需重新合成，以此处实际报价为准。</text><button class="primary" disabled="{{D}}" loading="{{E}}" bindtap="{{F}}"> 确认继续生成 </button></view></view><view class="creation-summary"><view class="creation-heading"><text class="creation-heading-title">创作信息</text><text class="creation-heading-caption">本次作品的内容与设置</text></view><view class="creation-content"><text class="creation-label">{{G}}</text><text class="creation-prompt">{{H}}</text></view><view class="creation-specs"><view class="creation-spec"><text class="creation-label">画质</text><text class="creation-value">{{I}}</text></view><view class="creation-spec"><text class="creation-label">画面比例</text><text class="creation-value">{{J}}</text></view><view class="creation-spec"><text class="creation-label">目标时长</text><text class="creation-value">{{K}}</text></view></view><text class="hint">最终时长以实际合成的视频为准。</text></view></block><view class="micro-action-row micro-action-row--detail" slot="actions"><button class="micro-action-button micro-action-secondary" bindtap="{{L}}"> 创作记录</button><button class="micro-action-button micro-action-secondary" disabled="{{M}}" bindtap="{{N}}"> 刷新状态</button><button class="primary micro-action-button micro-action-primary" bindtap="{{O}}"> 再创作一部 </button></view></micro-page>