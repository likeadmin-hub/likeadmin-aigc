          "type": "array",
          "example": [
            "https://example.com/reference.jpg"
          ],
          "children": {
            "item": {
              "type": "string",
              "example": "https://example.com/reference.jpg",
              "description": "一张参考图片的 HTTP(S) URL，任务处理期间须可读取。"
            }
          },
          "description": "参考图片 URL 字符串数组，用于参考图编辑。每项须为可访问的 HTTP(S) 图片地址，与 prompt 配合描述编辑目标，不影响默认按次价格。"
        },
        "prompt": {
          "type": "string",
          "example": "窗边的橘猫，清晨阳光，写实摄影",
          "description": "图片内容、风格或编辑目标的文本描述。文生图时应填写具体内容，参考图编辑时与 urls 配合使用，不影响默认按次价格。"
        },
        "image_size": {
          "type": "string",
          "default": "1K",
          "example": "1K",
          "options": "1K / 2K / 4K",
          "description": "分辨率规格。1K 适合预览，2K 提升清晰度，4K 适合高清素材。与 aspect_ratio 配合使用，三档默认同为 6 点/次。"
        },
        "aspect_ratio": {
          "type": "string",
          "default": "auto",
          "example": "1:1",
          "options": "auto / 1:1 / 16:9 / 9:16 / 4:3 / 3:4 / 3:2 / 2:3 / 5:4 / 4:5 / 21:9",
          "description": "输出画幅比例，与 image_size 共同决定尺寸。默认 auto，横图和竖图按用途选择，实际尺寸以结果为准，不影响默认按次价格。"
        }
      },
      "default_params": {
        "image_size": "1K",
        "aspect_ratio": "auto"
      }
    },
