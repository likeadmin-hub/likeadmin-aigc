                  "jpeg"
                ],
                "type": "string",
                "default": "png",
                "required": false,
                "description": "适用生成方式 text_to_image（可选；条件必填见说明）：生成图像的格式；默认值：\"png\"\n适用生成方式 image_to_image（可选；条件必填见说明）：生成图像的格式；默认值：\"png\""
              },
              "guidance_scale": {
                "type": "number",
