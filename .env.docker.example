# Copy this file to .env.docker and replace every value marked CHANGE_ME.
COMPOSE_PROJECT_NAME=likeadmin-aigc
HTTP_PORT=8080
TZ=Asia/Shanghai

MYSQL_DATABASE=likeadmin_aigc_saas
MYSQL_USER=likeadmin
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Permanent random secret used when hashing account passwords. This is not a
# login password. Generate it once, back it up, and never change it after install.
PROJECT_UNIQUE_IDENTIFICATION=CHANGE_ME_LONG_RANDOM_SALT
# Public domain or server IP only; do not include http://, https:// or a path.
PROJECT_HTTP_HOST=localhost
# Default login password assigned when the platform creates a tenant admin.
PROJECT_DEFAULT_PASSWORD=CHANGE_ME_DEFAULT_PASSWORD

# Platform administrator created only on the first database initialization.
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
