# Copy this file to .env.docker and replace every value marked CHANGE_ME.
COMPOSE_PROJECT_NAME=likeadmin-aigc
HTTP_PORT=8080
TZ=Asia/Shanghai

MYSQL_DATABASE=likeadmin_aigc_saas
MYSQL_USER=likeadmin
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Used as the application password salt. Generate a long random value once and
# do not change it after installation, otherwise existing passwords stop working.
PROJECT_UNIQUE_IDENTIFICATION=CHANGE_ME_LONG_RANDOM_SALT
PROJECT_HTTP_HOST=localhost
PROJECT_DEFAULT_PASSWORD=CHANGE_ME_DEFAULT_PASSWORD

# Created only when the database is initialized for the first time.
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
